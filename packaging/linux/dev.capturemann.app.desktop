[Desktop Entry]
Type=Application
Version=1.5
Name=CaptureMann
GenericName=Screen Recorder
Comment=Screenshots and screen recording, for people and for AI agents
Exec=@BINDIR@/cm-desktop %F
TryExec=@BINDIR@/cm-desktop
Icon=dev.capturemann.app
Terminal=false
Categories=AudioVideo;Video;Recorder;
Keywords=screenshot;screen recording;screencast;capture;webcam;
StartupNotify=false
StartupWMClass=dev.capturemann.app
MimeType=video/mp4;video/quicktime;video/x-m4v;video/x-matroska;video/webm;audio/mp4;audio/x-m4a;audio/x-wav;audio/wav;audio/mpeg;
