<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the main executable (cm-desktop), applied by packaging/macos/bundle.sh.
  Under the hardened runtime (CM_HARDENED=1, needed for notarization) the Info.plist usage
  strings alone do not let an app open the camera or the microphone; these two do.
  Screen Recording needs no entitlement (TCC only). The app is not sandboxed.
  Deliberately NOT present: com.apple.security.cs.disable-library-validation. A bundled FFmpeg or
  dylib must instead be signed with the same identity as the app (bundle.sh does that for
  CM_FFMPEG_BUNDLE). Helpers (cm-overlay, cm-mcp, capturemann) open no devices: no entitlements.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.camera</key><true/>
    <key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
