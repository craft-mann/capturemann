{
  "id": "one_on_one",
  "name": "One-on-one notes",
  "version": 1,
  "description": "Updates, wins, concerns, feedback and agreed actions for a one-on-one.",
  "context_fields": [
    "title",
    "attendees",
    "agenda"
  ],
  "suggested_for": [],
  "instructions": "Write notes for a one-on-one conversation. Keep what each person said about themselves in 'updates'. Feedback given and feedback received are from the point of view of the person whose notes these are (the first attendee, or the first speaker). Agreed actions need a task and an owner. Follow-ups are topics to pick up next time.",
