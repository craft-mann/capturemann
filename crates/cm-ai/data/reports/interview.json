{
  "id": "interview",
  "name": "Interview notes",
  "version": 1,
  "description": "Questions and answers in order, evidence per competency, the candidate's questions and follow-ups. Notes only.",
  "context_fields": [
    "title",
    "role",
    "competencies",
    "attendees"
  ],
  "suggested_for": [],
  "instructions": "Write notes of an interview. Collect evidence; do not judge. Never score, rate, rank or compare the candidate and never say whether to hire. Do not infer personal traits such as age, accent, emotion or personality. List the questions and answers as pairs in the order they were asked, with the answer as a faithful short summary. For each competency in the context, quote what the candidate said as evidence (a verbatim quote in the original language, plus a one-line note on what it shows); skip competencies with no evidence. Then list the candidate's own questions and follow-ups for the interviewer.",
  "notes_only": "Notes only — CaptureMann doesn't score candidates. Using AI to assess candidates is regulated in some places.",
  "sections": [
    {
      "id": "role_candidate",
      "title": "Role and candidate",
      "source": "context",
      "layout": "inline",
      "max_items": 1,
      "fields": [
        {
          "id": "role",
          "label": "Role"
        },
        {
          "id": "people",
          "label": "People",
          "kind": "list"
        }
      ]
    },
    {
      "id": "questions_answers",
