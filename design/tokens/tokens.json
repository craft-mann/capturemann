{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "ink":      { "$type": "color", "$value": "#0A0A0B", "$description": "App ground (dark theme)" },
    "surface":  { "$type": "color", "$value": "#111113", "$description": "Panels, cards" },
    "sidebar":  { "$type": "color", "$value": "#0E0E10", "$description": "Sidebar / footer ground" },
    "surface-2": { "$type": "color", "$value": "#141417", "$description": "Secondary buttons; second step of the surface ladder (redesign)" },
    "raised":   { "$type": "color", "$value": "#1E1E22", "$description": "Hover, selected row, inputs" },
    "field":    { "$type": "color", "$value": "#0D0D0F", "$description": "Inputs and the segmented-control track (redesign)" },
    "border":   { "$type": "color", "$value": "#222226", "$description": "Card borders and row dividers. The redesign kit calls this --line" },
    "line":     { "$type": "color", "$value": "#2E2E34", "$description": "Strong borders, switch-off track, keycaps. The redesign kit calls this --line-strong" },
    "text":     { "$type": "color", "$value": "#EDEDEF", "$description": "Primary text on dark" },
    "text-2":   { "$type": "color", "$value": "#C9C9CF", "$description": "Body text on dark" },
    "text-3":   { "$type": "color", "$value": "#A1A1A9", "$description": "Secondary text" },
    "mist":     { "$type": "color", "$value": "#8B8B93", "$description": "Labels, captions (min for small text on ink)" },
    "faint":    { "$type": "color", "$value": "#6E6E76", "$description": "Disabled labels, placeholders, decorative glyphs. Below the 4.5:1 floor: never for text that must be read" },
    "paper":    { "$type": "color", "$value": "#F6F6F4", "$description": "Light theme ground" },
    "rec":      { "$type": "color", "$value": "#FF4F3A", "$description": "Record, Stop and destructive confirmations (OD-17). The ONLY red. Text on it is ink, never white." },
    "rec-hover": { "$type": "color", "$value": "#FF6551", "$description": "Hover of a rec button" },
    "rec-soft": { "$type": "color", "$value": "#FF6E5C", "$description": "Rec icon or label on a dark rec tint" },
    "agent":    { "$type": "color", "$value": "#5B8CFF", "$description": "MCP / CLI / agent activity" },
    "agent-text": { "$type": "color", "$value": "#8FB0FF", "$description": "Agent-colored text on dark" },
    "success":  { "$type": "color", "$value": "#3DD68C" },
    "warning":  { "$type": "color", "$value": "#F5B84A" },
    "light": {
      "ground":  { "$type": "color", "$value": "#F6F6F4" },
      "sidebar": { "$type": "color", "$value": "#EFEFEC" },
      "surface": { "$type": "color", "$value": "#FFFFFF" },
      "border":  { "$type": "color", "$value": "#E4E4E0" },
      "line":    { "$type": "color", "$value": "#D6D6D1" },
      "text":    { "$type": "color", "$value": "#0A0A0B" },
      "text-2":  { "$type": "color", "$value": "#44444B" },
      "mist":    { "$type": "color", "$value": "#55555C" },
      "agent":   { "$type": "color", "$value": "#3B6FE8" },
      "primary": { "$type": "color", "$value": "#0A0A0B", "$description": "Primary button on light: ink fill, white text (OD-17: no rec dot)" },
      "surface-2": { "$type": "color", "$value": "#FAFAF8" },
      "field":   { "$type": "color", "$value": "#EFEFEC" },
      "faint":   { "$type": "color", "$value": "#6B6B72" },
      "rec-soft": { "$type": "color", "$value": "#D93A27" }
    },
    "primary": { "$type": "color", "$value": "#EDEDEF", "$description": "Primary button on dark (OD-17): neutral, the text colour, with ink text" },
    "primary-hover": { "$type": "color", "$value": "#D9D9DC" }
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["Geist", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["Geist Mono", "ui-monospace", "SFMono-Regular", "Consolas", "monospace"] }
  },
  "fontSize": {
    "caption": { "$type": "dimension", "$value": "12px" },
    "ui":      { "$type": "dimension", "$value": "14px" },
    "body":    { "$type": "dimension", "$value": "15px" },
    "title":   { "$type": "dimension", "$value": "17px" },
    "h2":      { "$type": "dimension", "$value": "22px" },
    "h1":      { "$type": "dimension", "$value": "26px" },
    "display": { "$type": "dimension", "$value": "64px" }
  },
  "letterSpacing": {
    "display":  { "$type": "dimension", "$value": "-0.045em" },
    "heading":  { "$type": "dimension", "$value": "-0.03em" },
    "monoLabel": { "$type": "dimension", "$value": "0.04em" }
  },
  "radius": {
    "dialog": { "$type": "dimension", "$value": "18px", "$description": "Confirm dialog, sheets (18 to 20 px; 20 is 2xl)" },
    "xs": { "$type": "dimension", "$value": "6px",  "$description": "Keycaps, tags" },
    "sm": { "$type": "dimension", "$value": "8px",  "$description": "Nav items, small buttons" },
    "md": { "$type": "dimension", "$value": "10px", "$description": "Buttons, list rows" },
    "lg": { "$type": "dimension", "$value": "14px", "$description": "Cards, preview" },
    "xl": { "$type": "dimension", "$value": "16px", "$description": "Launcher, floating HUD" },
    "2xl": { "$type": "dimension", "$value": "20px", "$description": "Brand sheets" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" }
  },
  "size": {
    "control": { "$type": "dimension", "$value": "40px", "$description": "Default button / input height" },
    "target":  { "$type": "dimension", "$value": "44px", "$description": "Min hit target (HUD buttons, list rows 48)" },
    "sidebar": { "$type": "dimension", "$value": "248px", "$description": "Was 220 before the redesign" },
    "rail":    { "$type": "dimension", "$value": "64px", "$description": "Icon rail on full-window pages" },
    "toast":   { "$type": "dimension", "$value": "440px" },
    "inspector": { "$type": "dimension", "$value": "300px" },
    "launcher": { "$type": "dimension", "$value": "760px" }
  },
  "shadow": {
    "float": { "$type": "shadow", "$value": "0 30px 80px rgba(0,0,0,0.6)" },
    "hud":   { "$type": "shadow", "$value": "0 18px 50px rgba(0,0,0,0.6)" }
  }
}
