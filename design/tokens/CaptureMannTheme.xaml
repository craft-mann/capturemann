<!--
  CaptureMann theme for XAML UIs (WPF / WinUI 3 / .NET MAUI / Avalonia).
  Dark theme values. CmBorder is the redesign kit's line token and CmLine is its line-strong token. CmPrimary is the neutral primary button (OD-17); red (CmRec) is only for Record, Stop and destructive confirmations. Light overrides are listed in tokens.json under color.light.
  Avalonia: change the root xmlns to https://github.com/avaloniaui and use <ResourceDictionary> the same way.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="CmInkColor">#FF0A0A0B</Color>
  <Color x:Key="CmSidebarColor">#FF0E0E10</Color>
  <Color x:Key="CmSurfaceColor">#FF111113</Color>
  <Color x:Key="CmRaisedColor">#FF1E1E22</Color>
  <Color x:Key="CmBorderColor">#FF222226</Color>
  <Color x:Key="CmLineColor">#FF2E2E34</Color>
  <Color x:Key="CmTextColor">#FFEDEDEF</Color>
  <Color x:Key="CmText2Color">#FFC9C9CF</Color>
  <Color x:Key="CmText3Color">#FFA1A1A9</Color>
  <Color x:Key="CmMistColor">#FF8B8B93</Color>
  <Color x:Key="CmPaperColor">#FFF6F6F4</Color>
  <Color x:Key="CmRecColor">#FFFF4F3A</Color>
  <Color x:Key="CmAgentColor">#FF5B8CFF</Color>
  <Color x:Key="CmAgentTextColor">#FF8FB0FF</Color>
  <Color x:Key="CmSuccessColor">#FF3DD68C</Color>
  <Color x:Key="CmWarningColor">#FFF5B84A</Color>

  <Color x:Key="CmSurface2Color">#FF141417</Color>
  <Color x:Key="CmFieldColor">#FF0D0D0F</Color>
  <Color x:Key="CmFaintColor">#FF6E6E76</Color>
  <Color x:Key="CmRecHoverColor">#FFFF6551</Color>
  <Color x:Key="CmRecSoftColor">#FFFF6E5C</Color>
  <Color x:Key="CmPrimaryColor">#FFEDEDEF</Color>
  <Color x:Key="CmPrimaryHoverColor">#FFD9D9DC</Color>

  <SolidColorBrush x:Key="CmInkBrush" Color="{StaticResource CmInkColor}"/>
  <SolidColorBrush x:Key="CmSidebarBrush" Color="{StaticResource CmSidebarColor}"/>
  <SolidColorBrush x:Key="CmSurfaceBrush" Color="{StaticResource CmSurfaceColor}"/>
  <SolidColorBrush x:Key="CmRaisedBrush" Color="{StaticResource CmRaisedColor}"/>
  <SolidColorBrush x:Key="CmBorderBrush" Color="{StaticResource CmBorderColor}"/>
  <SolidColorBrush x:Key="CmLineBrush" Color="{StaticResource CmLineColor}"/>
  <SolidColorBrush x:Key="CmTextBrush" Color="{StaticResource CmTextColor}"/>
  <SolidColorBrush x:Key="CmText2Brush" Color="{StaticResource CmText2Color}"/>
  <SolidColorBrush x:Key="CmText3Brush" Color="{StaticResource CmText3Color}"/>
  <SolidColorBrush x:Key="CmMistBrush" Color="{StaticResource CmMistColor}"/>
  <SolidColorBrush x:Key="CmPaperBrush" Color="{StaticResource CmPaperColor}"/>
  <SolidColorBrush x:Key="CmRecBrush" Color="{StaticResource CmRecColor}"/>
  <SolidColorBrush x:Key="CmAgentBrush" Color="{StaticResource CmAgentColor}"/>
  <SolidColorBrush x:Key="CmAgentTextBrush" Color="{StaticResource CmAgentTextColor}"/>
  <SolidColorBrush x:Key="CmSuccessBrush" Color="{StaticResource CmSuccessColor}"/>
  <SolidColorBrush x:Key="CmWarningBrush" Color="{StaticResource CmWarningColor}"/>
  <SolidColorBrush x:Key="CmSurface2Brush" Color="{StaticResource CmSurface2Color}"/>
  <SolidColorBrush x:Key="CmFieldBrush" Color="{StaticResource CmFieldColor}"/>
  <SolidColorBrush x:Key="CmFaintBrush" Color="{StaticResource CmFaintColor}"/>
  <SolidColorBrush x:Key="CmRecHoverBrush" Color="{StaticResource CmRecHoverColor}"/>
  <SolidColorBrush x:Key="CmRecSoftBrush" Color="{StaticResource CmRecSoftColor}"/>
  <SolidColorBrush x:Key="CmPrimaryBrush" Color="{StaticResource CmPrimaryColor}"/>
  <SolidColorBrush x:Key="CmPrimaryHoverBrush" Color="{StaticResource CmPrimaryHoverColor}"/>

  <CornerRadius x:Key="CmRadiusSm">8</CornerRadius>
  <CornerRadius x:Key="CmRadiusMd">10</CornerRadius>
  <CornerRadius x:Key="CmRadiusLg">14</CornerRadius>
  <CornerRadius x:Key="CmRadiusXl">16</CornerRadius>
  <CornerRadius x:Key="CmRadiusDialog">18</CornerRadius>

  <!-- Sizes. -->
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="CmSidebarWidth">248</system:Double>
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="CmRailWidth">64</system:Double>
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="CmToastWidth">440</system:Double>
</ResourceDictionary>
